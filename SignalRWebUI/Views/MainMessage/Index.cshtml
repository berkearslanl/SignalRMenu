@model CreateMessageDto
@{
    Layout = "~/Views/UILayout/Index.cshtml";
}
<style>
    .book_section .form_container .form-control { margin-bottom: 4px; }
    .book_section .form_container form > div { margin-bottom: 14px; }
    .book_section .form_container .text-danger { display: block; font-size: 14px; }
    .book_section .form_container .btn_box { margin-bottom: 0; }
</style>
<section class="book_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>
                Bize Yazın
            </h2>
        </div>

        @if (TempData["MessageSent"] != null)
        {
            <div class="alert alert-success">@TempData["MessageSent"]</div>
        }

        <div class="row">
            <div class="col-md-6">
                <div class="form_container">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div>
                            <input type="text" class="form-control" placeholder="Adınız Soyadınız" asp-for="NameSurname" required />
                            <span asp-validation-for="NameSurname" class="text-danger"></span>
                        </div>
                        <div>
                            <input type="tel" class="form-control" placeholder="Telefon Numaranız" asp-for="Phone" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div>
                            <input type="email" class="form-control" placeholder="Mail Adresiniz" asp-for="Mail" required />
                            <span asp-validation-for="Mail" class="text-danger"></span>
                        </div>
                        <div>
                            <input type="text" class="form-control" placeholder="Konu" asp-for="Subject" required />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>
                        <div>
                            <textarea class="form-control" rows="5" placeholder="Mesajınız" asp-for="MessageContent" style="height:auto;padding-top:12px;" required></textarea>
                            <span asp-validation-for="MessageContent" class="text-danger"></span>
                        </div>
                        <div class="btn_box">
                            <button>
                                Mesajı Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-md-6">
                <div class="map_container">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3012.0040696773553!2d29.082145711362553!3d40.981391720960644!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cac7b6f09a5c0d%3A0x59d14e224634cb31!2zQXRhdMO8cmsgQ2QuLCBLYWTEsWvDtnkvxLBzdGFuYnVs!5e0!3m2!1str!2str!4v1795174888621!5m2!1str!2str" width="100%" height="400" style="border:0;" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>