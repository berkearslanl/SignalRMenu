@model RegisterDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kayıt Ol</title>
    <link rel="stylesheet" href="~/css/identity.css" />
</head>
<body class="auth-body">
    <div class="auth-wrap">

        <!-- SOL PANEL -->
        <div class="auth-side">
            <div>
                <div class="auth-brand">
                    <div class="auth-brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3v7a3 3 0 0 0 3 3v8" /><path d="M7 3v7" /><path d="M10 3v7a3 3 0 0 1-3 3" /><path d="M18 21V3c-2.5 1-4 4-4 8 0 2 1 3 4 3" /></svg>
                    </div>
                    <div class="auth-brand-name">SignalR<span>Menu</span></div>
                </div>

                <h2>Yönetim ekibine katıl</h2>
                <p>Hesabını oluştur, restoranının tüm operasyonunu tek panelden kontrol etmeye başla.</p>

                <ul class="auth-features">
                    <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4 10-10" /></svg></span>Anlık sipariş ve bildirim takibi</li>
                    <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4 10-10" /></svg></span>Dolu / boş masa durumu</li>
                    <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4 10-10" /></svg></span>Rezervasyon yönetimi</li>
                </ul>
            </div>
            <div class="auth-side-foot">© SignalRMenu Yönetim Paneli</div>
        </div>

        <!-- FORM -->
        <div class="auth-main">
            <h1 class="auth-title">Kayıt Ol</h1>
            <p class="auth-sub">Yeni bir yönetici hesabı oluştur</p>
            <form asp-controller="Identity" asp-action="Register" method="post">
                <div class="auth-row">
                    <div class="auth-group">
                        <label for="Name">Ad</label>
                        <div class="auth-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                            <input type="text" id="Name" name="Name" asp-for="Name" placeholder="Ad" required />
                        </div>
                    </div>
                    <div class="auth-group">
                        <label for="Surname">Soyad</label>
                        <div class="auth-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                            <input type="text" id="Surname" name="Surname" asp-for="Surname" placeholder="Soyad" required />
                        </div>
                    </div>
                </div>

                <div class="auth-group">
                    <label for="UserName">Kullanıcı Adı</label>
                    <div class="auth-input">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8" /></svg>
                        <input type="text" id="Username" name="Username" asp-for="Username" placeholder="Kullanıcı Adı" required />
                    </div>
                </div>

                <div class="auth-group">
                    <label for="Email">E-posta</label>
                    <div class="auth-input">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <input type="email" id="Email" name="Email" asp-for="Email" placeholder="ornek@mail.com" required />
                    </div>
                </div>

                <div class="auth-group">
                    <label for="Password">Şifre</label>
                    <div class="auth-input">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                        <input type="password" id="Password" name="Password" asp-for="Password" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="auth-btn">Kayıt Ol</button>
            </form>

            <div class="auth-footer">
                Zaten hesabın var mı? <a asp-controller="Identity" asp-action="Login">Giriş Yap</a>
            </div>
        </div>
    </div>
</body>
</html>