@{
    Layout = "~/Views/UILayout/Index.cshtml";
}
<section class="message_section layout_padding">
    <div class="container mt-5">

        <div class="row">
            <div class="col-12">
                <h3 class="text-center mb-4">Canlı Mesajlaşma</h3>
            </div>
        </div>

        <div class="row p-1">
            <div class="col-2">Kullanıcı Adınız :</div>
            <div class="col-5">
                <input type="text" id="userusername" class="form-control" />
            </div>
        </div>

        <div class="row p-1">
            <div class="col-2">Mesajınız :</div>
            <div class="col-5">
                <input type="text" id="usermessage" class="form-control" />
            </div>
        </div>

        <div class="row p-1">
            <div class="col-2"></div>
            <div class="col-5">
                <input type="button" id="usersendbutton" value="Mesaj Gönder" class="btn btn-block btn-warning w-100" />
            </div>
        </div>

        <div class="row p-1">
            <div class="col-12">
                <hr />
            </div>
        </div>

        <div class="row p-1">
            <div class="col-12">
                <ul id="messagelist" class="list-group" style="max-height: 400px; overflow-y: auto;"></ul>
            </div>
        </div>

    </div>
</section>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/js/chat.js"></script>