@model List<ResultTestimonialDto>
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Müşteri Yorumları</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Müşteri Yorumu Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Resim</th>
                                    <th scope="col">Ad Soyad</th>
                                    <th scope="col">Unvan</th>
                                    <th scope="col">Yorum</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int count = 0; }
                                @foreach (var item in Model ?? new List<ResultTestimonialDto>())
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td><img src="@item.ImageUrl" style="width:80px;height:80px;border-radius:20px" /></td>
                                        <td>@item.Name</td>
                                        <td>@item.Title</td>
                                        <td>@item.Content</td>
                                        <td>@(item.Status ? "Aktif" : "Pasif")</td>
                                        <td style="white-space:nowrap;">
                                            @if (item.Status)
                                            {
                                                <a href="/Testimonial/ChangeTestimonialStatus/@item.TestimonialId" class="btn btn-outline-secondary">Pasif Yap</a>
                                            }
                                            else
                                            {
                                                <a href="/Testimonial/ChangeTestimonialStatus/@item.TestimonialId" class="btn btn-outline-success">Aktif Yap</a>
                                            }
                                            <a href="/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-outline-warning">Düzenle</a>
                                            <a href="/Testimonial/DeleteTestimonial/@item.TestimonialId" class="btn btn-outline-danger">Sil</a>
                                        </td>
                                    </tr>
                                }
                                @if (Model == null || !Model.Any())
                                {
                                    <tr><td colspan="7" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <a href="/Testimonial/CreateTestimonial" class="btn btn-outline-primary">Yeni Müşteri Yorumu Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>