@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    var clientconnection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7003/SignalRHub").build();
    clientconnection.start().then(() => {
        setInterval(() => {
            clientconnection.invoke("DashboardValues");
        }, 1000);
    }).catch((err) => { console.log(err) });

    clientconnection.on("ReceiveClientCount", (clientCount) => {
        $("#clients").text(clientCount);
    });
    clientconnection.on("ReceiveAdminCount", (adminCount) => {
        $("#admins").text(adminCount);
    });
    clientconnection.on("ReceiveTotalAmountMoneyCase", (totalAmountMoneyCase) => {
        $("#caseMoneyTotal").text(totalAmountMoneyCase);
    });
    clientconnection.on("ReceiveActiveTableCount", (activeTableCount) => {
        $("#activeTable").text(activeTableCount);
    });
    clientconnection.on("ReceiveDiscountCount", (discountCount) => {
        $("#discount").text(discountCount);
    });
    clientconnection.on("ReceiveOrderCount", (orderCount) => {
        $("#orders").text(orderCount);
    });
    clientconnection.on("ReceiveTestimonialCount", (testimonialCount) => {
        $("#testimonials").text(testimonialCount);
    });

    clientconnection.on("ReceiveMenuTableCount", (tables) => {
        var html = "";
            html += `   <div class="d-flex justify-content-between mb-1">
                             <span class="text-muted">Toplam Masa Sayısı</span>
                             <span class="text-muted fw-bold"> ${tables}</span>
                        </div>
                        <div class="progress mb-2" style="height: 7px;">
                             <div class="progress-bar bg-success" role="progressbar" style="width: ${tables}%" aria-valuenow="${tables}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${tables}%">
                              </div>
                        </div> `;
        document.getElementById("totalTableCountProgress").innerHTML = html;
    });

    clientconnection.on("ReceiveAvgProductPrice", (avgProductPrice) => {
        var price = Number(avgProductPrice);
        var priceText = price.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " ₺";
        var percent = Math.min(100, Math.round(price * 100 / 300));
        var html = "";
        html += `   <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Ortalama Ürün Fiyatı</span>
                                                <span class="text-muted fw-bold"> ${priceText}</span>
                                </div>
                                <div class="progress mb-2" style="height: 7px;">
                                <div class="progress-bar bg-info" role="progressbar" style="width: ${percent}%" aria-valuenow="${percent}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${percent}%"></div>
                                </div>`;
        document.getElementById("avgProductPrice").innerHTML = html;
    });

    clientconnection.on("ReceiveProductCount", (totalProduct) => {
        var html = "";
        html += `   <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Toplam Ürün Sayısı</span>
                                            <span class="text-muted fw-bold"> ${totalProduct}</span>
                                </div>
                                <div class="progress mb-2" style="height: 7px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: ${totalProduct}%" aria-valuenow="${totalProduct}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${totalProduct}%"></div>
                                </div>`;
        document.getElementById("totalProductCount").innerHTML = html;
    });

    clientconnection.on("ReceiveActiveBookingCount", (activeBooking) => {
        var html = "";
        html += `   <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Yaklaşan Rezervasyon Sayısı</span>
                                    <span class="text-muted fw-bold"> ${activeBooking}</span>
                                </div>
                                <div class="progress mb-2" style="height: 7px;">
                                                <div class="progress-bar bg-warning" role="progressbar" style="width: ${activeBooking}%" aria-valuenow="${activeBooking}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${activeBooking}%"></div>
                                </div>`;
        document.getElementById("activeBookingCount").innerHTML = html;
    });
</script>

