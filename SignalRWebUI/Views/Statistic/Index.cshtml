@{
	Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script type="text/javascript">
	$(document).ready(() => {
		var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7003/SignalRHub").build();

		connection.start().then(() => {
			setInterval(() => {
				connection.invoke("SendStatisticsCount");
			}, 1000);
		}).catch((err) => { console.log(err) });

		connection.on("ReceiveCategoryCount", (categoryValue) => {
			$("#categoryCount").text(categoryValue);
		});
		connection.on("ReceiveProductCount", (productValue) => {
			$("#productCount").text(productValue);
		});
		connection.on("ReceiveActiveCategoryCount", (activeCategoryValue) => {
			$("#activeCategoryCount").text(activeCategoryValue);
		});
		connection.on("ReceivePassiveCategoryCount", (passiveCategoryValue) => {
			$("#passiveCategoryCount").text(passiveCategoryValue);
		});
		connection.on("ReceiveProductCountByHamburger", (hamburgerValue) => {
			$("#hamburgerProductCount").text(hamburgerValue);
		});
		connection.on("ReceiveProductCountByDrink", (drinkValue) => {
			$("#drinkProductCount").text(drinkValue);
		});
		connection.on("ReceiveAvgProductPrice", (avgPriceValue) => {
			$("#avgProductPrice").text(avgPriceValue);
		});
		connection.on("ReceiveProductNameByMaxPrice", (maxPriceProductValue) => {
			$("#maxPriceProductName").text(maxPriceProductValue);
		});
		connection.on("ReceiveProductNameByMinPrice", (minPriceProductValue) => {
			$("#minPriceProductName").text(minPriceProductValue);
		});
		connection.on("ReceiveTableCount", (tableCountValue) => {
			$("#tableCount").text(tableCountValue);
		});
		connection.on("ReceiveTotalOrderCount", (totalOrderValue) => {
			$("#totalOrderCount").text(totalOrderValue);
		});
		connection.on("ReceiveLastOrderPrice", (lastOrderPriceValue) => {
			$("#lastOrderPrice").text(lastOrderPriceValue);
		});
		connection.on("ReceiveTodayOrderPrice", (todayOrderPriceValue) => {
			$("#todayOrderPrice").text(todayOrderPriceValue);
		});
		connection.on("ReceiveTableMaxOrder", (tableMaxOrderValue) => {
			$("#tableMaxOrder").text(tableMaxOrderValue);
		});
		connection.on("ReceiveTotalAmountMoneyCase", (moneyCaseValue) => {
			$("#totalMoneyCase").text(moneyCaseValue);
		});
		connection.on("ReceiveBookingCount", (bookingCountValue) => {
			$("#bookingCount").text(bookingCountValue);
		});
	});
</script>

