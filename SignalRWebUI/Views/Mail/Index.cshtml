@model CreateMailDto
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .mail-form .form-group label { font-weight: 600; font-size: 13px; }
    .mail-form .form-control { height: 44px; }
    .mail-form textarea.form-control { height: auto; min-height: 220px; resize: vertical; }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Mail Gönder</h4>

        @if (TempData["MailSuccess"] != null)
        {
            <div class="alert alert-success">@TempData["MailSuccess"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="row">
            <div class="col-md-12">
                <form method="post" class="mail-form">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title"><i class="la la-envelope"></i> Yeni Mail</div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Alıcı Adı</label>
                                        <input type="text" class="form-control" asp-for="ReceiveName" placeholder="Alıcının adını giriniz" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Alıcı E-posta</label>
                                        <input type="email" class="form-control" asp-for="ReceiveMail" placeholder="ornek@mail.com" required>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Konu</label>
                                <input type="text" class="form-control" asp-for="Subject" placeholder="Mail konusunu giriniz" required>
                            </div>
                            <div class="form-group">
                                <label>Mesaj</label>
                                <textarea class="form-control" asp-for="Body" rows="9" placeholder="Mesajınızı yazınız" required></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="card-action">
                        <button type="submit" class="btn btn-success"><i class="la la-send"></i> Gönder</button>
                        <a href="/Dashboard/Index" class="btn btn-danger">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>