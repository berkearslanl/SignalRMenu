@model List<ResultAboutDto>
<style>
    .offer_section .box .img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>
<section class="about_section layout_padding">
    <div class="container  ">
        @foreach (var item in Model)
        {
            <div class="row">
                <div class="col-md-6 ">
                    <div class="img-box">
                        <img src="@item.ImageUrl" alt="">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="heading_container">
                            <h2>
                                @item.Title
                            </h2>
                        </div>
                        <p>
                            @item.Description
                        </p>
                        <a href="/MainAbout/Index">
                            Daha Fazlası
                        </a>
                    </div>
                </div>

            </div>
        }
    </div>
</section>
