@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<div class="sidebar">
    <div class="sidebar-wrapper">
        <div class="user">
            <div class="photo">
                <img src="~/Ready-Bootstrap-Dashboard-master/assets/img/profile.jpg">
            </div>
            <div class="info">
                <a class="" data-toggle="collapse" href="#collapseExample" aria-expanded="true">
                    <span>
                        Hizrian
                        <span class="user-level">Administrator</span>
                        <span class="caret"></span>
                    </span>
                </a>
                <div class="clearfix"></div>

                <div class="collapse in" id="collapseExample" aria-expanded="true" style="">
                    <ul class="nav">
                        <li>
                            <a href="#profile">
                                <span class="link-collapse">My Profile</span>
                            </a>
                        </li>
                        <li>
                            <a href="#edit">
                                <span class="link-collapse">Edit Profile</span>
                            </a>
                        </li>
                        <li>
                            <a href="#settings">
                                <span class="link-collapse">Settings</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <ul class="nav">
            <li class="nav-item @(controller == "About" ? "active" : "")">
                <a href="/About/Index">
                    <i class="la la-info-circle"></i>
                    <p>Hakkımda</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Booking" ? "active" : "")">
                <a href="/Booking/Index">
                    <i class="la la-calendar-check-o"></i>
                    <p>Rezervasyonlar</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Category" ? "active" : "")">
                <a href="/Category/Index">
                    <i class="la la-th-list"></i>
                    <p>Kategoriler</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Contact" ? "active" : "")">
                <a href="/Contact/Index">
                    <i class="la la-phone"></i>
                    <p>İletişim</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Dashboard" ? "active" : "")">
                <a href="/Dashboard/Index">
                    <i class="la la-dashboard"></i>
                    <p>Dashboard</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Discount" ? "active" : "")">
                <a href="/Discount/Index">
                    <i class="la la-tags"></i>
                    <p>İndirimler</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Feature" ? "active" : "")">
                <a href="/Feature/Index">
                    <i class="la la-star"></i>
                    <p>Öne Çıkan</p>
                </a>
            </li>
            <li class="nav-item @(controller == "AdminMessage" ? "active" : "")">
                <a href="/AdminMessage/Index">
                    <i class="la la-envelope"></i>
                    <p>Gelen Mesajlar</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Mail" ? "active" : "")">
                <a href="/Mail/Index">
                    <i class="la la-send"></i>
                    <p>Mail Gönder</p>
                </a>
            </li>
            <li class="nav-item @(controller == "MoneyCase" ? "active" : "")">
                <a href="/MoneyCase/Index">
                    <i class="la la-money"></i>
                    <p>Kasa</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Notification" ? "active" : "")">
                <a href="/Notification/Index">
                    <i class="la la-bell"></i>
                    <p>Bildirimler</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Order" ? "active" : "")">
                <a href="/Order/Index">
                    <i class="la la-shopping-cart"></i>
                    <p>Siparişler</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Product" ? "active" : "")">
                <a href="/Product/Index">
                    <i class="la la-cutlery"></i>
                    <p>Ürünler</p>
                </a>
            </li>
            <li class="nav-item @(controller == "ProgressBar" ? "active" : "")">
                <a href="/ProgressBar/Index">
                    <i class="la la-tasks"></i>
                    <p>Progress</p>
                </a>
            </li>
            <li class="nav-item @(controller == "QrCode" ? "active" : "")">
                <a href="/QrCode/Index">
                    <i class="la la-qrcode"></i>
                    <p>QR Code</p>
                </a>
            </li>
            <li class="nav-item @(controller == "RestaurantTable" ? "active" : "")">
                <a href="/RestaurantTable/Index">
                    <i class="la la-th-large"></i>
                    <p>Masalar</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Setting" ? "active" : "")">
                <a href="/Setting/Index">
                    <i class="la la-cog"></i>
                    <p>Ayarlar</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Statistic" ? "active" : "")">
                <a href="/Statistic/Index">
                    <i class="la la-bar-chart"></i>
                    <p>İstatistikler</p>
                </a>
            </li>
            <li class="nav-item @(controller == "Testimonial" ? "active" : "")">
                <a href="/Testimonial/Index">
                    <i class="la la-comments"></i>
                    <p>Müşteri Yorumları</p>
                </a>
            </li>
        </ul>
    </div>
</div>
