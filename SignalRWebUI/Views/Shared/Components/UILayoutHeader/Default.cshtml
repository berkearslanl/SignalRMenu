                    </a>
                    <form class="form-inline">
                        <button class="btn  my-2 my-sm-0 nav_search-btn" type="submit">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </form>
                    <a href="/MainMenu/Index" class="order_online" style="white-space:nowrap;">
                        Sipariş Verin
                    </a>
                </div>
            </div>
        </nav>
    </div>
</header>
