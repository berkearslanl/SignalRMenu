
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
@{
    var tableId = Context.Request.Cookies["TableId"];
}
<script>
    /* global signalR */
    var visitorConnection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7003/SignalRHub?type=customer&tableId=@tableId")
        .build();

    visitorConnection.on("ReceiveBasketCount", function (count) {
        var badge = document.getElementById("basketCount");
        if (!badge) return;
        badge.textContent = count > 99 ? "99+" : count;
        badge.style.display = count > 0 ? "" : "none";
    });

    visitorConnection.start().catch(function (err) { console.log(err); });

    window.addEventListener("pagehide", function () { visitorConnection.stop(); });
</script>

