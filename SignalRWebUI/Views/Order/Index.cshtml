@model List<GetOrdersWithTableDto>
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script type="text/javascript">
    $(document).ready(() => {
        var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7003/SignalRHub").build();

        connection.start().then(() => {
            setInterval(() => {
                connection.invoke("GetOrderList");
            }, 1000);
        }).catch((err) => { console.log(err) });

        connection.on("ReceiveOrderList", (orders) => {
            let tablehtml = `<div class="table-responsive"><table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Masa Adı</th>
                                        <th scope="col">Açıklama</th>
                                        <th scope="col">Toplam Tutar</th>
                                        <th scope="col">Sipariş Tarihi</th>
                                        <th scope="col">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>`
            var count = 0;
            $.each(orders, (index, item) => {
                count++;
                tablehtml += `
                                                <tr>
                                                <td>${count}</td>
                                                <td>${item.tableName}</td>
                                                <td>${item.description}</td>
                                                <td>${item.totalPrice}</td>
                                                <td>${item.orderDate}</td>
                                            <td style="white-space:nowrap;">
                                                        <a href="/Order/UpdateOrder/${item.orderID}" class="btn btn-outline-warning">Düzenle</a>
                                                        <a href="/Order/DeleteOrder/${item.orderID}" class="btn btn-outline-danger">Sil</a>
                                            </td>
                                        </tr>
                                   `
            });
            tablehtml += `</tbody></table></div>`
            $("#orderList").html(tablehtml);
        });
    });
</script>


<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Siparişler</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Sipariş Listesi</div>
                    </div>
                    <div class="card-body">
                        <div id="orderList"></div>
                        <a href="/Order/CreateOrder" class="btn btn-outline-primary">Yeni Sipariş Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
