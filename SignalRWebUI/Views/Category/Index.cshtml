@model List<ResultCategoryDto>
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Kategoriler</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Kategori Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Kategori Adı</th>
                                    <th scope="col">Kategori Durumu</th>
                                    <th scope="col">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int count = 0; }
                                @foreach (var item in Model ?? new List<ResultCategoryDto>())
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.CategoryName</td>
                                        <td>@(item.Status ? "Aktif" : "Pasif")</td>
                                        <td style="white-space:nowrap;">
                                            @if (item.Status)
                                            {
                                                <a href="/Category/ChangeCategoryStatus/@item.CategoryId" class="btn btn-outline-secondary">Pasif Yap</a>
                                            }
                                            else
                                            {
                                                <a href="/Category/ChangeCategoryStatus/@item.CategoryId" class="btn btn-outline-success">Aktif Yap</a>
                                            }
                                            <a href="/Category/UpdateCategory/@item.CategoryId" class="btn btn-outline-warning">Düzenle</a>
                                            <a href="/Category/DeleteCategory/@item.CategoryId" class="btn btn-outline-danger">Sil</a>
                                        </td>
                                    </tr>
                                }
                                @if (Model == null || !Model.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <a href="/Category/CreateCategory" class="btn btn-outline-primary">Yeni Kategori Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>