@model List<ResultTastyDto>
@{
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="book_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>
                Rapid Api Foods
            </h2>
        </div>
        <div class="row">
            <div class="col-lg-12 table-responsive mb-5">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ad</th>
                            <th>süre</th>
                            <th>resim</th>
                            <th>video</th>
                            <th>kalori</th>
                            <th>karbonhidrat</th>
                            <th>yağ</th>
                            <th>lif</th>
                            <th>protein</th>
                            <th>şeker</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.name</td>
                                <td>@item.total_time_minutes</td>
                                <td>@item.thumbnail_url</td>
                                <td>@item.original_video_url</td>
                                <td>@item.nutrition.calories</td>
                                <td>@item.nutrition.carbohydrates</td>
                                <td>@item.nutrition.fat</td>
                                <td>@item.nutrition.fiber</td>
                                <td>@item.nutrition.protein</td>
                                <td>@item.nutrition.sugar</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>