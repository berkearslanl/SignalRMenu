@model List<ResultBookingDto>
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>


<script type="text/javascript">
            var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7003/SignalRHub").build();

            connection.on("ReceiveBookingList", (bookings) => {
                var html = "";
                var count = 0;
                bookings.forEach((item)=>{
                    count++;
                    html+=`<tr>
                        <td>${count}</td>
                        <td>${item.name}</td>
                        <td>${item.email}</td>
                        <td>${item.phone}</td>
                        <td>${item.personCount}</td>
                    <td>${new Date(item.bookDate).toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "short" })}</td>
    <td>${new Date(item.createdAt).toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "short" })}</td>
        <td style="white-space:nowrap;">
                        <a href="/Booking/UpdateBooking/${item.bookingId}" class="btn btn-outline-warning">Düzenle</a>
        <a href="/Booking/DeleteBooking/${item.bookingId}" class="btn btn-outline-danger">Sil</a>
         </td>
              </tr>`;
            });
      document.getElementById("bookingTableBody").innerHTML=html;
        });
        connection.start().catch(function(err){console.log(err);});
</script>



<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Rezervasyonlar</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Rezervasyon Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Ad Soyad</th>
                                    <th scope="col">E-posta</th>
                                    <th scope="col">Telefon</th>
                                    <th scope="col">Kişi Sayısı</th>
                                    <th scope="col">Rezervasyon Tarihi</th>
                                    <th scope="col">Oluşturulma Tarihi</th>
                                    <th scope="col">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody id="bookingTableBody">
                                @{ int count = 0; }
                                @foreach (var item in Model ?? new List<ResultBookingDto>())
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Name</td>
                                        <td>@item.Email</td>
                                        <td>@item.Phone</td>
                                        <td>@item.PersonCount</td>
                                        <td>@item.BookDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td style="white-space:nowrap;">
                                            <a href="/Booking/UpdateBooking/@item.BookingId" class="btn btn-outline-warning">Düzenle</a>
                                            <a href="/Booking/DeleteBooking/@item.BookingId" class="btn btn-outline-danger">Sil</a>
                                        </td>
                                    </tr>
                                }
                                @if (Model == null || !Model.Any())
                                {
                                    <tr><td colspan="8" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <a href="/Booking/CreateBooking" class="btn btn-outline-primary">Yeni Rezervasyon Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
