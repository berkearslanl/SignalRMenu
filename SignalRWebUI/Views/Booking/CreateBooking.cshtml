@model CreateBookingDto
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Rezervasyonlar</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Rezervasyon Ekleme Sayfası</div>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label>Ad Soyad</label>
                                <input type="text" class="form-control" asp-for="Name" placeholder="Ad soyad giriniz" required>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>E-posta</label>
                                <input type="email" class="form-control" asp-for="Email" placeholder="E-posta giriniz" required>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Telefon</label>
                                <input type="tel" class="form-control" asp-for="Phone" placeholder="Telefon giriniz" required>
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Kişi Sayısı</label>
                                <input type="number" class="form-control" asp-for="PersonCount" placeholder="Kişi sayısını giriniz" required>
                                <span asp-validation-for="PersonCount" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Rezervasyon Tarihi</label>
                                <input type="datetime-local" class="form-control" asp-for="BookDate" required
                                       value="@(Model == null || Model.BookDate == default ? "" : Model.BookDate.ToString("yyyy-MM-ddTHH:mm"))">
                                <span asp-validation-for="BookDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-action">
                        <button type="submit" class="btn btn-success">Ekle</button>
                        <a href="/Booking/Index" class="btn btn-danger">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>