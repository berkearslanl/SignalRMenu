@model List<ResultContactDto>
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">İletişim</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">İletişim Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Adres</th>
                                    <th scope="col">Telefon</th>
                                    <th scope="col">E-posta</th>
                                    <th scope="col">Açıklama</th>
                                    <th scope="col">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int count = 0; }
                                @foreach (var item in Model ?? new List<ResultContactDto>())
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Location</td>
                                        <td>@item.Phone</td>
                                        <td>@item.Mail</td>
                                        <td>@item.Description</td>
                                        <td style="white-space:nowrap;">
                                            <a href="/Contact/UpdateContact/@item.ContactId" class="btn btn-outline-warning">Düzenle</a>
                                            <a href="/Contact/DeleteContact/@item.ContactId" class="btn btn-outline-danger">Sil</a>
                                        </td>
                                    </tr>
                                }
                                @if (Model == null || !Model.Any())
                                {
                                    <tr><td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <a href="/Contact/CreateContact" class="btn btn-outline-primary">Yeni İletişim Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>