@model List<ResultMessageDto>
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
    
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script type="text/javascript">
    var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7003/SignalRHub").build();

    connection.on("ReceiveMessageList", (messages) => {
        var html = "";
        var count = 0;
        if (messages.length === 0)
                html = '<tr><td colspan="8" class="text-center text-muted">Kayıt bulunamadı.</td></tr>';
        messages.forEach((item) => {
            count++;
            html +=`
                <tr>
                                            <td>${count}</td>
                                            <td>${item.nameSurname}</td>
                                            <td>${item.phone}</td>
                                            <td>${item.mail}</td>
                                            <td>${item.subject}</td>
                                            <td style="min-width:260px;white-space:pre-wrap;">${item.messageContent}</td>
                                                <td style="white-space:nowrap;">${new Date(item.sendDate).toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "short" })}</td>
                                            <td style="white-space:nowrap;">
                                                <a href="/AdminMessage/DeleteMessage/${item.messageId}" class="btn btn-outline-danger" onclick="return confirm('Bu mesaj silinsin mi?');">Sil</a>
                                            </td>
                                        </tr>
                                        `;
        });
        document.getElementById("messagesTableBody").innerHTML = html;
    });
    connection.start().catch(function (err) { console.log(err); });
</script>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Gelen Mesajlar</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Mesaj Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Ad Soyad</th>
                                    <th scope="col">Telefon</th>
                                    <th scope="col">E-posta</th>
                                    <th scope="col">Konu</th>
                                    <th scope="col">Mesaj</th>
                                    <th scope="col">Tarih</th>
                                    <th scope="col">İşlemler</th>
                                </tr>
                            </thead>
                                <tbody id="messagesTableBody">
                                @{ int count = 0; }
                                @foreach (var item in (Model ?? new List<ResultMessageDto>()).OrderByDescending(x => x.SendDate))
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.NameSurname</td>
                                        <td>@item.Phone</td>
                                        <td>@item.Mail</td>
                                        <td>@item.Subject</td>
                                        <td style="min-width:260px;white-space:pre-wrap;">@item.MessageContent</td>
                                        <td style="white-space:nowrap;">@item.SendDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td style="white-space:nowrap;">
                                            <a href="/AdminMessage/DeleteMessage/@item.MessageId" class="btn btn-outline-danger" onclick="return confirm('Bu mesaj silinsin mi?');">Sil</a>
                                        </td>
                                    </tr>
                                }
                                @if (Model == null || !Model.Any())
                                {
                                    <tr><td colspan="8" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>