<!DOCTYPE html>
<html>
@await Component.InvokeAsync("UILayoutHead")
<body class="@(IsSectionDefined("Hero") ? "" : "sub_page")">
    <div class="hero_area">
        <div class="bg-box">
            <img src="~/feane-1.0.0/images/hero-bg.jpg" alt="">
        </div>
        @await Component.InvokeAsync("UILayoutHeader")
        @RenderSection("Hero", required: false)
    </div>

    @RenderBody()

    @await Component.InvokeAsync("UILayoutFooter")
    @await Component.InvokeAsync("UILayoutTableWidget")
    @await Component.InvokeAsync("UILayoutScripts")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
